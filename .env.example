# =====================================================================
#  Zomato Real-Time Lakehouse - configuration
#  Change values here, then:  docker compose up -d
# =====================================================================
COMPOSE_PROJECT_NAME=zomato

# ---------- Event generator (the "Zomato app") ----------
# Peak-hour base rate. 50 orders/sec ~ 4.3M orders/day, ~1,000 events/sec in total
# (status updates + rider GPS pings + reviews). Raise to 200-500 for a heavier load.
ORDERS_PER_SEC=50
NUM_RESTAURANTS=20000
NUM_CUSTOMERS=200000
NUM_RIDERS=30000
# Fraction of orders deliberately corrupted (duplicates, nulls, negative amounts, late, bad JSON)
DIRTY_DATA_RATE=0.01
# Follow the Indian lunch/dinner demand curve (true) or stream at a flat rate (false)
DEMAND_CURVE=true
RIDER_PING_INTERVAL_SEC=3
# One Python process tops out at ~10-20k events/sec; add processes to go beyond
GENERATOR_PROCESSES=1

# ---------- Kafka ----------
KAFKA_BOOTSTRAP=kafka:9092

# ---------- S3 object store = the data lake (SeaweedFS). Keys must match storage/s3.json ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://s3:9000
LAKEHOUSE_BUCKET=lakehouse

# ---------- Postgres (serving warehouse for Grafana + dbt) ----------
PG_HOST=postgres
PG_PORT=5432
PG_DB=zomato
PG_USER=zomato
PG_PASSWORD=zomato

# ---------- Spark ----------
SPARK_MASTER=spark://spark-master:7077
STREAM_TRIGGER=15 seconds
AGG_TRIGGER=10 seconds
MAX_OFFSETS_PER_TRIGGER=300000
# Rolling retention (days) for the two firehose tables, enforced by the streaming app. 0 = keep forever.
# Rough size at the default rate: ~13 GB/day of bronze + silver events.
BRONZE_RETENTION_DAYS=3
RIDER_PINGS_RETENTION_DAYS=3
# How many recent days of streamed data the 30-minute gold job recomputes
STREAM_RECOMPUTE_DAYS=2

# ---------- Historical backfill (runs once automatically, re-run from Airflow) ----------
# Scales to billions: ~36k orders/sec per Spark core, ~23 bytes per order on disk.
#   1,000,000,000 orders = ~23 GB, ~2-4 h  (see "Billion-scale mode" in the README)
BACKFILL_ORDERS=5000000
BACKFILL_DAYS=365

# ---------- AI (Ask AI tab) ----------
# Groq API (OpenAI-compatible). Get a free key at https://console.groq.com/keys and paste it below.
# Other Groq models: llama-3.1-8b-instant (faster), openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=paste-your-groq-key-here
