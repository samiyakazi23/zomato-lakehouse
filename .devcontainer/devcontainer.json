{
  // Opens the project in GitHub Codespaces (VS Code in the cloud): nothing to install on your computer.
  // After it opens, run: Terminal > Run Task... > "Start project (Lite)"
  "name": "Zomato Analytics",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [8000, 8080, 8888],
  "portsAttributes": {
    "8000": { "label": "Website", "onAutoForward": "openBrowser" },
    "8080": { "label": "Airflow" },
    "8888": { "label": "Lake file browser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-azuretools.vscode-docker"] }
  }
}
